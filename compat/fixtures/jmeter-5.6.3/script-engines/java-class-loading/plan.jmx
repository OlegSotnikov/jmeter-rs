          <stringProp name="junitsampler.pkg.filter"></stringProp>
          <stringProp name="junitsampler.success">true</stringProp>
          <stringProp name="junitsampler.success.code">0</stringProp>
          <stringProp name="junitsampler.failure">fixture assertion failure</stringProp>
          <stringProp name="junitsampler.failure.code">1</stringProp>
          <stringProp name="junitsampler.error">fixture class or invocation error</stringProp>
          <stringProp name="junitsampler.error.code">2</stringProp>
          <boolProp name="junitsampler.exec.setup">true</boolProp>
          <boolProp name="junitsampler.append.error">true</boolProp>
          <boolProp name="junitsampler.append.exception">true</boolProp>
