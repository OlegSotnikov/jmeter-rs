        <hashTree/>
        <JUnitSampler guiclass="JUnitTestSamplerGui" testclass="JUnitSampler" testname="JUnit3 Request descriptor class" enabled="true">
          <boolProp name="junitsampler.junit4">false</boolProp>
          <stringProp name="junitSampler.classname">org.jmeter.rs.fixture.StaticJUnit3Case</stringProp>
