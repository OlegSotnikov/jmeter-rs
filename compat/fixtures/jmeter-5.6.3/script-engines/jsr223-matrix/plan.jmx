          <stringProp name="parameters">beanshell-inline-parameters</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">vars.put('beanshell_inline_marker','beanshell-inline'); return 'beanshell-inline';</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="BeanShell file" enabled="true">
          <stringProp name="scriptLanguage">beanshell</stringProp>
