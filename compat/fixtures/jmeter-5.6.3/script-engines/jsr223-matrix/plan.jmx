          <stringProp name="scriptLanguage">jexl3</stringProp>
          <stringProp name="parameters">jexl3-inline-parameters</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">vars.put('jexl3_inline_marker','jexl3-inline'); 'jexl3-inline'</stringProp>
        </JSR223Sampler>
        <hashTree/>
