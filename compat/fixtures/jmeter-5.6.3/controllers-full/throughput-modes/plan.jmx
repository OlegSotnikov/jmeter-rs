        <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="percent-after" enabled="true"><boolProp name="displayJMeterProperties">false</boolProp><boolProp name="displayJMeterVariables">false</boolProp><boolProp name="displaySystemProperties">false</boolProp></DebugSampler><hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
