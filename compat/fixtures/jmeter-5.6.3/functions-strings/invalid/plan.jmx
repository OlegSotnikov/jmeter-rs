<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Function strings negative matrix" enabled="true">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Negative function inputs" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="A1" elementType="Argument">
            <stringProp name="Argument.name">A1</stringProp>
            <stringProp name="Argument.value">alpha</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="parts_3" elementType="Argument">
            <stringProp name="Argument.name">parts_3</stringProp>
            <stringProp name="Argument.value">stale</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <collectionProp name="TestPlan.thread_groups"/>
      <stringProp name="TestPlan.comments">Original negative cases and accepted argument-boundary probes. Unknown names are kept distinct from known names with invalid arguments; the empty-delimiter split seeds parts_3=stale and retains its unresolved expansion as an indirect absence proof. No localized error prose or runtime output is asserted.</stringProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="One negative-case user" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="One iteration" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <longProp name="ThreadGroup.start_time">0</longProp>
        <longProp name="ThreadGroup.end_time">0</longProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="case-sensitive|known=${__V(A1)}|lower-name=${__v(A1)}|upper-name=${__V(A1)}|property-case=${__PROPERTY(fx.prop)}|plugin-case=${__base64Encode(a)}|plugin-upper=${__BASE64Encode(a)}" enabled="true">
          <boolProp name="displayJMeterProperties">false</boolProp>
          <boolProp name="displayJMeterVariables">true</boolProp>
          <boolProp name="displaySystemProperties">false</boolProp>
        </DebugSampler>
        <hashTree/>
        <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="undefined-and-defaults|raw=${MISSING}|v=${__V(MISSING)}|v-empty=${__V(MISSING,)}|v-fallback=${__V(MISSING,fallback)}|eval-var=${__evalVar(MISSING)}|property=${__property(no.such)}|property-fallback=${__property(no.such,,fallback)}|p=${__P(no.such)}|p-fallback=${__P(no.such,fallback)}" enabled="true">
          <boolProp name="displayJMeterProperties">false</boolProp>
          <boolProp name="displayJMeterVariables">true</boolProp>
          <boolProp name="displaySystemProperties">false</boolProp>
        </DebugSampler>
        <hashTree/>

        <!-- These rows exercise malformed inputs and accepted argument boundaries. The case is a corpus input, not a fabricated runtime result. -->
        <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="invalid-arguments|char=${__char(not-a-number)}|case=${__changeCase(MiXeD,INVALID)}|html=${__escapeHtml(one,two)}|url=${__urlencode()}" enabled="true">
          <boolProp name="displayJMeterProperties">false</boolProp>
          <boolProp name="displayJMeterVariables">false</boolProp>
          <boolProp name="displaySystemProperties">false</boolProp>
        </DebugSampler>
        <hashTree/>
        <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="codec-boundaries|unescape=${__unescape(\q)}|url=${__urldecode(%ZZ)}|url-short=${__urldecode(%A)}" enabled="true">
          <boolProp name="displayJMeterProperties">false</boolProp>
          <boolProp name="displayJMeterVariables">false</boolProp>
          <boolProp name="displaySystemProperties">false</boolProp>
        </DebugSampler>
        <hashTree/>
        <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="argument-boundaries|sum-empty=${__longSum()}" enabled="true">
          <boolProp name="displayJMeterProperties">false</boolProp>
          <boolProp name="displayJMeterVariables">false</boolProp>
          <boolProp name="displaySystemProperties">false</boolProp>
        </DebugSampler>
        <hashTree/>
        <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="accepted-side-effects|int-output=${__intSum(2,not-a-number)}|split-empty=${__split(one\,two,parts,)}|split-empty-prefix=${__split(one,)}|stale=${parts_3}" enabled="true">
          <boolProp name="displayJMeterProperties">false</boolProp>
          <boolProp name="displayJMeterVariables">true</boolProp>
          <boolProp name="displaySystemProperties">false</boolProp>
        </DebugSampler>
        <hashTree/>
        <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="invalid-known-functions|substring=${__substring(abc,4,5)}|strlen=${__strLen()}|random=${__Random(3,2)}|date=${__dateTimeConvert(not-a-date,yyyy-MM-dd,dd/MM/yyyy)}" enabled="false">
          <boolProp name="displayJMeterProperties">false</boolProp>
          <boolProp name="displayJMeterVariables">false</boolProp>
          <boolProp name="displaySystemProperties">false</boolProp>
        </DebugSampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
