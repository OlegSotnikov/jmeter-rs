    "raw_artifacts": "none; no oracle output is committed"
  },
  "normalization": {
    "ignored_fields": ["sample.hn", "ephemeral_ports", "temporary_paths", "arrival_order", "JVM_object_ids"],
    "timing_tolerances": {
      "timestamp": {"comparison": "descriptor-only", "allowed_variance": "wall-clock value is recorded by a future run but not asserted"},
      "elapsed": {"comparison": "bounded", "minimum_ms": 0, "maximum_ms": 30000, "allowed_tolerance_ms": 30000, "reason": "bounded startup and stop wait"},
