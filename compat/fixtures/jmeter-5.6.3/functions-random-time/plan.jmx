<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Original random and time function contract" enabled="true">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Fixed function inputs" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="choice1" elementType="Argument">
            <stringProp name="Argument.name">choice1</stringProp>
            <stringProp name="Argument.value">red</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="choice2" elementType="Argument">
            <stringProp name="Argument.name">choice2</stringProp>
            <stringProp name="Argument.value">blue</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="multi_matchNr" elementType="Argument">
            <stringProp name="Argument.name">multi_matchNr</stringProp>
            <stringProp name="Argument.value">3</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="multi_1" elementType="Argument">
            <stringProp name="Argument.name">multi_1</stringProp>
            <stringProp name="Argument.value">one</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="multi_2" elementType="Argument">
            <stringProp name="Argument.name">multi_2</stringProp>
            <stringProp name="Argument.value">two</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="multi_3" elementType="Argument">
            <stringProp name="Argument.name">multi_3</stringProp>
            <stringProp name="Argument.value">three</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="plan_phase_probe" elementType="Argument">
            <stringProp name="Argument.name">plan_phase_probe</stringProp>
            <stringProp name="Argument.value">${__threadNum}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <collectionProp name="TestPlan.thread_groups"/>
      <stringProp name="TestPlan.comments">Original bounded random/time function fixture; fixed domains make the static contract deterministic where JMeter permits it.</stringProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Two scoped function users" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Two fixed iterations" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">2</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">2</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <longProp name="ThreadGroup.start_time">0</longProp>
        <longProp name="ThreadGroup.end_time">0</longProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Configuration phase function inputs" enabled="true">
          <collectionProp name="Arguments.arguments">
            <elementProp name="config_phase_probe" elementType="Argument">
              <stringProp name="Argument.name">config_phase_probe</stringProp>
              <stringProp name="Argument.value">${__Random(4,4,config_phase_random)}</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
          </collectionProp>
        </Arguments>
        <hashTree/>
        <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="capture|thread=${__threadNum}|group=${__threadGroupName}|r_fixed=${__Random(4,4,r_fixed)}|r_range=${__Random(1,3,r_range)}|rd_fixed=${__RandomDate(yyyy-MM-dd,2024-02-29,2024-03-01,en_US,rd_fixed)}|rd_range=${__RandomDate(yyyy-MM-dd,2024-03-01,2024-03-04,en_US,rd_range)}|rfrom_simple=${__RandomFromMultipleVars(choice1,rfrom_simple)}|rfrom_choices=${__RandomFromMultipleVars(choice1|choice2,rfrom_choices)}|rfrom_multi=${__RandomFromMultipleVars(multi,rfrom_multi)}|rs_fixed=${__RandomString(6,A,rs_fixed)}|rs_choices=${__RandomString(6,ab,rs_choices)}|uuid=${__UUID}|counter_local=${__counter(TRUE,counter_local)}|counter_local_again=${__counter(TRUE,counter_local_again)}|counter_global=${__counter(FALSE,counter_global)}|dt=${__dateTimeConvert(2024-02-29,yyyy-MM-dd,dd/MM/yyyy,dt)}|dt_epoch=${__dateTimeConvert(1709251200000,,yyyy-MM-dd,dt_epoch)}|shift=${__timeShift(yyyy-MM-dd,2024-02-28,P2D,en_US,shift)}|shift_epoch=${__timeShift(,1709251200000,PT10S,,shift_epoch)}|time_ms=${__time(,time_ms)}|time_s=${__time(/1000,time_s)}|time_ymd=${__time(YMD,time_ymd)}" enabled="true">
          <boolProp name="displayJMeterProperties">false</boolProp>
          <boolProp name="displayJMeterVariables">true</boolProp>
          <boolProp name="displaySystemProperties">false</boolProp>
        </DebugSampler>
        <hashTree/>
        <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="side-effects|thread=${__threadNum}|r_fixed=${r_fixed}|r_range=${r_range}|rd_fixed=${rd_fixed}|rd_range=${rd_range}|rfrom_simple=${rfrom_simple}|rfrom_choices=${rfrom_choices}|rfrom_multi=${rfrom_multi}|rs_fixed=${rs_fixed}|rs_choices=${rs_choices}|counter_local=${counter_local}|counter_local_again=${counter_local_again}|counter_global=${counter_global}|dt=${dt}|dt_epoch=${dt_epoch}|shift=${shift}|shift_epoch=${shift_epoch}|time_ms=${time_ms}|time_s=${time_s}|time_ymd=${time_ymd}|plan_phase=${plan_phase_probe}|config_phase=${config_phase_probe}|config_random=${config_phase_random}" enabled="true">
          <boolProp name="displayJMeterProperties">false</boolProp>
          <boolProp name="displayJMeterVariables">true</boolProp>
          <boolProp name="displaySystemProperties">false</boolProp>
        </DebugSampler>
        <hashTree/>
        <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="undefined=${UNDEFINED_RANDOM}|unknown=${__random(1,3)}|known=${__Random(4,4)}|case=${__TIME(YMD)}" enabled="true">
          <boolProp name="displayJMeterProperties">false</boolProp>
          <boolProp name="displayJMeterVariables">false</boolProp>
          <boolProp name="displaySystemProperties">false</boolProp>
        </DebugSampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
