<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="GUI WorkBench migration plan" enabled="true">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <stringProp name="TestPlan.comments">Non-empty WorkBench migration source; no enabled execution branch.</stringProp>
    </TestPlan>
    <hashTree/>
    <WorkBench guiclass="WorkBenchGui" testclass="WorkBench" testname="Non-empty GUI WorkBench" enabled="true">
      <stringProp name="WorkBench.comments">Copied preparation item remains outside the executable plan.</stringProp>
    </WorkBench>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Workbench preparation arguments" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="workbench_marker" elementType="Argument">
            <stringProp name="Argument.name">workbench_marker</stringProp>
            <stringProp name="Argument.value">nonempty</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
