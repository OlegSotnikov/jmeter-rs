<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Headless GUI persistence matrix" enabled="true">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="GUI matrix values" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="display_mode" elementType="Argument">
            <stringProp name="Argument.name">display_mode</stringProp>
            <stringProp name="Argument.value">headless</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="locale_probe" elementType="Argument">
            <stringProp name="Argument.name">locale_probe</stringProp>
            <stringProp name="Argument.value">en-US</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="timezone_probe" elementType="Argument">
            <stringProp name="Argument.name">timezone_probe</stringProp>
            <stringProp name="Argument.value">UTC</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="charset_probe" elementType="Argument">
            <stringProp name="Argument.name">charset_probe</stringProp>
            <stringProp name="Argument.value">UTF-8</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="headless_probe" elementType="Argument">
            <stringProp name="Argument.name">headless_probe</stringProp>
            <stringProp name="Argument.value">true</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="display_probe" elementType="Argument">
            <stringProp name="Argument.name">display_probe</stringProp>
            <stringProp name="Argument.value">none</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <collectionProp name="TestPlan.thread_groups"/>
      <stringProp name="TestPlan.comments">Original GUI-authored metadata preservation probe; literal UTF-8 café and 雪.</stringProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <PlatformSettings guiclass="com.example.jmeter.PlatformSettingsGui" testclass="com.example.jmeter.PlatformSettings" testname="Preserve GUI settings extension" enabled="true">
        <stringProp name="PlatformSettings.look_and_feel">system</stringProp>
        <stringProp name="PlatformSettings.toolbar">visible</stringProp>
        <stringProp name="PlatformSettings.tree_state">expanded:TestPlan,collapsed:WorkBench</stringProp>
        <stringProp name="PlatformSettings.undo_history">5</stringProp>
        <stringProp name="PlatformSettings.locale">en-US</stringProp>
        <stringProp name="PlatformSettings.timezone">UTC</stringProp>
        <stringProp name="PlatformSettings.charset">UTF-8</stringProp>
        <stringProp name="PlatformSettings.headless">true</stringProp>
        <stringProp name="PlatformSettings.display">none</stringProp>
      </PlatformSettings>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="One headless-safe user" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="One iteration" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <longProp name="ThreadGroup.start_time">0</longProp>
        <longProp name="ThreadGroup.end_time">0</longProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="GUI settings source marker" enabled="true">
          <boolProp name="displayJMeterProperties">false</boolProp>
          <boolProp name="displayJMeterVariables">true</boolProp>
          <boolProp name="displaySystemProperties">false</boolProp>
        </DebugSampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
