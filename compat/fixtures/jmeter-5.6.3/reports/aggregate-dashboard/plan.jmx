      <collectionProp name="TestPlan.thread_groups"/>
      <stringProp name="TestPlan.comments">Bounded one-iteration report-plan smoke source. The exact listener/dashboard descriptors use the hand-authored JTL inputs, while this plan keeps the future -n command executable and finite.</stringProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
