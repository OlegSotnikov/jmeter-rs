          <BSFPostProcessor guiclass="TestBeanGUI" testclass="BSFPostProcessor" testname="Disabled legacy BSF postprocessor" enabled="false">
            <stringProp name="scriptLanguage">beanshell</stringProp>
            <stringProp name="parameters">source-only-disabled</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">vars.put('disabled', 'must-not-run')</stringProp>
          </BSFPostProcessor>
          <hashTree/>

          <!-- An unknown plug-in subtree is disabled but must remain lossless. -->
          <PluginPostProcessor guiclass="com.example.jmeter.PluginPostProcessorGui" testclass="com.example.jmeter.PluginPostProcessor" testname="Opaque processor plug-in" enabled="false" pluginVersion="0.1" custom="retain-me">
            <stringProp name="plugin.known">known &amp; value</stringProp>
            <pluginProperty name="plugin.opaque" encoding="raw">opaque &amp; property &lt;bytes&gt;</pluginProperty>
            <pluginExtension format="nested" marker="α">
              <opaqueChild key="one"><![CDATA[raw <plugin> bytes]]></opaqueChild>
            </pluginExtension>
          </PluginPostProcessor>
          <hashTree>
            <PluginChild guiclass="com.example.jmeter.PluginChildGui" testclass="com.example.jmeter.PluginChild" testname="Opaque child" enabled="false" childFlag="keep">
              <pluginChildProperty name="child.raw">child &amp; raw</pluginChildProperty>
            </PluginChild>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
      <ResultAction guiclass="ResultActionGui" testclass="ResultAction" testname="Disabled result status action" enabled="false">
        <stringProp name="TestLogicalAction">START_NEXT_ITERATION_OF_CURRENT_LOOP</stringProp>
      </ResultAction>
