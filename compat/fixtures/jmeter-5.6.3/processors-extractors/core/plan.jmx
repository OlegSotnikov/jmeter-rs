          </JMESPathExtractor>
          <hashTree/>
          <DebugPostProcessor guiclass="TestBeanGUI" testclass="DebugPostProcessor" testname="Candidate variable snapshot" enabled="true">
            <boolProp name="displayJMeterProperties">true</boolProp>
            <boolProp name="displayJMeterVariables">true</boolProp>
            <boolProp name="displaySystemProperties">false</boolProp>
            <boolProp name="displaySamplerProperties">true</boolProp>
          </DebugPostProcessor>
          <hashTree/>
          <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="Disabled BeanShell postprocessor" enabled="false">
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters">source-only-disabled</stringProp>
