  "normalization_policies": [
    {
      "id": "NORM-STRUCTURE-001",
      "name": "Ordered semantic structure",
      "rule": "Compare semantic trees and event streams while preserving ordered children, sample order, enabled state, source paths, and all declared fields. Sort only maps for which JMeter defines map semantics."
    },
    {
      "id": "NORM-JMX-001",
      "name": "JMX semantic round trip",
      "rule": "Compare root metadata, alternating hashTree topology, typed properties, aliases, unknown payloads, and XML values semantically. Byte equality is required only for fixture regions explicitly marked lexical-preserving."
    },
    {
      "id": "NORM-JTL-001",
      "name": "JTL neutral event stream",
      "rule": "Parse CSV or XML into a neutral sample event stream and compare tree shape, ordering, fields, nested results, assertions, headers, and configured columns. Do not discard fields that a format cannot represent."
    },
    {
      "id": "NORM-TIME-001",
      "name": "Controlled timing comparison",
      "rule": "Use exact timing fields only with a controlled local fixture clock. Else apply only the tolerance recorded by the case manifest; timestamps, hostnames, and ephemeral ports are never normalized implicitly."
    },
    {
      "id": "NORM-CLI-001",
      "name": "CLI and process comparison",
      "rule": "Compare option acceptance, exit status, fatal-versus-sample-failure mapping, and diagnostic category. Normalize only manifest-declared temporary paths, timestamps, or host-specific values; do not compare localized prose as the sole oracle."
    },
    {
      "id": "NORM-CONFIG-001",
      "name": "Configuration precedence",
      "rule": "Compare property sources, load order, repeats, defaults, and effective values in a fixed environment. Unknown properties remain observable and are not silently dropped."
    },
    {
      "id": "NORM-ENV-001",
      "name": "Explicit environment normalization",
      "rule": "Set locale, timezone, charset, working directory, and environment allowlist in the case manifest; set a seed when the upstream surface supports it, otherwise record null and the reason. Record target triple, JVM, hostname, and dependency hashes."
    },
    {
      "id": "NORM-REPORT-001",
      "name": "Report metric comparison",
      "rule": "Compare report outputs from deterministic result corpora with the algorithm named by the feature. Keep dashboard percentile estimates separate from GUI aggregate algorithms."
    },
    {
      "id": "NORM-EXTERNAL-001",
      "name": "External boundary accounting",
      "rule": "An external result is comparable only when its adapter, service, driver, plugin, or platform version is pinned. Missing capability must be reported; it cannot be normalized away or treated as Rust support."
    },
    {
      "id": "NORM-SECURITY-001",
      "name": "Security and resource boundary comparison",
      "rule": "Compare stable error codes, bounded failure behavior, redaction, and no-drop invariants. Secrets, arbitrary network access, and ambient process execution are never fixture inputs."
    }
  ],
