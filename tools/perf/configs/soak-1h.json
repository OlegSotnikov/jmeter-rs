      {"id": "result_queue_depth", "source": "owned-runner", "unit": "count", "required": true},
      {"id": "cpu_time_ns", "source": "owned-runner", "unit": "nanoseconds", "required": true},
      {"id": "allocation_bytes", "source": "owned-runner", "unit": "bytes", "required": true}
    ],
    "queue_policy": "bounded-fail-on-overflow",
    "max_samples": 10000000
  },
  "thresholds": {
    "baseline_policy": "explicit-values-only",
    "missing_metric_policy": "fail",
    "baseline_artifact": null,
    "baselines": {
      "minimum_completion_count": 1,
      "minimum_sample_count": 1,
      "minimum_steady_state_samples": 10,
      "source": "explicit-config"
    },
    "rules": [
      {"id": "soak-no-dropped-results", "metric": "results_dropped", "operator": "=", "value": 0, "unit": "count", "scope": "run"},
      {"id": "soak-no-queue-overflows", "metric": "queue_overflows", "operator": "=", "value": 0, "unit": "count", "scope": "run"},
      {"id": "soak-no-failures", "metric": "samples_failed", "operator": "=", "value": 0, "unit": "count", "scope": "run"},
      {"id": "soak-minimum-completions", "metric": "samples_completed", "operator": ">=", "value": 1, "unit": "count", "scope": "run"}
      ,{"id": "soak-throughput-floor", "metric": "throughput", "operator": ">=", "value": 1, "unit": "operations-per-second", "scope": "steady-state"}
      ,{"id": "soak-sample-count-floor", "metric": "sample_count", "operator": ">=", "value": 1, "unit": "count", "scope": "run"}
      ,{"id": "soak-elapsed-p95-ceiling", "metric": "sample_elapsed_p95", "operator": "<=", "value": 1000000000, "unit": "nanoseconds", "scope": "steady-state"}
      ,{"id": "soak-elapsed-p99-ceiling", "metric": "sample_elapsed_p99", "operator": "<=", "value": 1000000000, "unit": "nanoseconds", "scope": "steady-state"}
      ,{"id": "soak-schedule-p95-ceiling", "metric": "schedule_delay_p95", "operator": "<=", "value": 1000000000, "unit": "nanoseconds", "scope": "steady-state"}
      ,{"id": "soak-schedule-p99-ceiling", "metric": "schedule_delay_p99", "operator": "<=", "value": 1000000000, "unit": "nanoseconds", "scope": "steady-state"}
    ]
  },
  "leak_sampling": {
    "enabled": true,
    "interval_seconds": 60,
    "initial_delay_seconds": 300,
    "baseline": "first-stable-window",
    "windows": {"warmup_samples": 5, "steady_state_samples": 10, "final_samples": 10},
    "metrics": ["rss_bytes", "open_fd_count", "thread_count", "task_count", "result_queue_depth", "cpu_time_ns", "allocation_bytes"],
    "growth_rules": [
      {"id": "soak-rss-growth", "metric": "rss_bytes", "unit": "bytes", "comparison": "final-window-vs-baseline", "max_absolute": 209715200, "max_relative": 0.2},
      {"id": "soak-fd-growth", "metric": "open_fd_count", "unit": "count", "comparison": "final-window-vs-baseline", "max_absolute": 4, "max_relative": 0.1},
      {"id": "soak-thread-growth", "metric": "thread_count", "unit": "count", "comparison": "final-window-vs-baseline", "max_absolute": 2, "max_relative": 0.1},
      {"id": "soak-task-growth", "metric": "task_count", "unit": "count", "comparison": "final-window-vs-baseline", "max_absolute": 2, "max_relative": 0.1},
      {"id": "soak-queue-drain", "metric": "result_queue_depth", "unit": "count", "comparison": "final-window-vs-baseline", "max_absolute": 0, "max_relative": 0},
      {"id": "soak-cpu-growth", "metric": "cpu_time_ns", "unit": "nanoseconds", "comparison": "final-window-vs-baseline", "max_absolute": 1000000000, "max_relative": 1},
      {"id": "soak-allocation-growth", "metric": "allocation_bytes", "unit": "bytes", "comparison": "final-window-vs-baseline", "max_absolute": 104857600, "max_relative": 1}
    ],
    "unavailable_policy": "fail",
    "require_final_sample": true
  },
