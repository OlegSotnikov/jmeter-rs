      {"id": "schedule_delay_p99", "unit": "nanoseconds"}
    ],
    "resource_metrics": [
      {"id": "rss_bytes", "source": "owned-runner", "unit": "bytes", "required": true},
      {"id": "open_fd_count", "source": "owned-runner", "unit": "count", "required": true},
      {"id": "thread_count", "source": "owned-runner", "unit": "count", "required": true},
