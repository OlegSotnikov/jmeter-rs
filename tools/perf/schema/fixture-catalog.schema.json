{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OlegSotnikov/jmeter-rs/blob/main/tools/perf/schema/fixture-catalog.schema.json",
  "x-schema-id": "jmeter-rs.perf-fixture-catalog",
  "x-schema-version": 1,
  "title": "Performance fixture and case binding catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "fixtures"],
  "properties": {
    "schema_id": {"const": "jmeter-rs.perf-fixture-catalog"},
    "schema_version": {"const": 1},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fixture"}
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile_id", "fixture_family_id", "source_path", "source_sha256", "case_manifest_path", "case_id"],
      "properties": {
        "id": {"type": "string", "maxLength": 64, "pattern": "^FX-[A-Z0-9-]+$"},
        "profile_id": {"const": "jmeter-5.6.3"},
        "fixture_family_id": {"type": "string", "maxLength": 64, "pattern": "^FX-[A-Z0-9-]+$"},
        "source_path": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^compat/fixtures/[^/].*",
          "not": {"pattern": "(^|/)\\.\\.?(/|$)"}
        },
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "case_manifest_path": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^compat/fixtures/[^/].*",
          "not": {"pattern": "(^|/)\\.\\.?(/|$)"}
        },
        "case_id": {"type": "string", "maxLength": 128, "pattern": "^ORACLE-[A-Z0-9-]+$"}
      }
    }
  }
}
